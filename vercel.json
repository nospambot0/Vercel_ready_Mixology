{
  "version": 2,
  "installCommand": "pnpm install --no-frozen-lockfile",
  "buildCommand": "pnpm --filter @workspace/hillview-hookah-mixology run build",
  "outputDirectory": "artifacts/hillview-hookah-mixology/dist/public",
  "rewrites": [
    {"source": "/manage/karmadj", "destination": "/karmadj.html"},
    {"source": "/((?!api/).*)", "destination": "/index.html"}
  ]
}